\name{CompreSSoR-package}
\alias{CompreSSoR}
\docType{package}
\title{Reference-Anchored Compressed Summary Statistics}
\description{
  CompreSSoR stores genome-wide association study summary statistics in a
  reference-anchored, block-indexed Parquet format. The standard profile uses
  compact quantised numeric columns while retaining exact p-values and sparse
  exception values; an exact profile is also available.
}
\seealso{
  \code{\link{compress_sumstats}}, \code{\link{read_sumstats}},
  \code{\link{build_cache}}
}
\keyword{package}
