\name{reference_cache_dir}
\alias{reference_cache_dir}
\title{Return the CompreSSoR reference cache directory}
\usage{
reference_cache_dir(cache_dir = NULL)
}
\arguments{
  \item{cache_dir}{Optional cache directory.}
}
\description{Returns the configured per-user cache directory for reference assets.}
\value{A directory path.}
